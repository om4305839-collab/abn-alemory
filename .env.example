# ───────────────────────────────────────────────────────────────
# كشري ابن العمراوي — متغيرات البيئة (أسماء فقط، بدون قيم سرية)
# انسخ هذا الملف إلى .env محلياً، وأضف نفس القيم في Vercel → Settings → Environment Variables
# لا ترفع .env إلى GitHub أبداً.
# ───────────────────────────────────────────────────────────────

# [مطلوب] رابط الاتصال بقاعدة PostgreSQL (Supabase: Project Settings → Database → Connection string)
# على Vercel استخدم رابط الـ pooler (Transaction mode, port 6543) مع ?sslmode=require
DATABASE_URL=

# [مطلوب] الرابط العام للموقع (بدون / في النهاية) — يُستخدم للتحقق من Origin (CSRF) ومن CORS
APP_URL=http://localhost:3000

# [مطلوب] سر عشوائي طويل (32+ بايت) لتوقيع الروابط وتشفير أسرار MFA واشتقاق مفاتيح فرعية.
# ولّده بالأمر:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# تحذير: تغييره يُبطل روابط تتبع الطلبات ويُبطل أسرار MFA المخزّنة.
APP_SECRET=

# [اختياري] أصول إضافية مسموحة لطلبات الكتابة (مفصولة بفواصل) — مثل دومين مخصص ثانٍ
ALLOWED_ORIGINS=

# إلزام المصادقة الثنائية (TOTP) للأدمن — الافتراضي true (موصى به)
REQUIRE_ADMIN_MFA=true

# ── التخزين ──────────────────────────────────────────────────
# إذا تم ضبط المتغيرين التاليين يُستخدم Supabase Storage (موصى به للإنتاج)،
# وإلا يُستخدم تخزين خاص داخل PostgreSQL (مناسب للتجربة المحلية).
# مفتاح service_role سري للغاية: على الخادم فقط، لا تضعه في NEXT_PUBLIC_ ولا ترفعه إلى GitHub.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# أسماء الـ Buckets (receipts = خاص، site-media = عام للقراءة فقط)
SUPABASE_RECEIPTS_BUCKET=receipts
SUPABASE_MEDIA_BUCKET=site-media

# ── CAPTCHA (اختياري — Cloudflare Turnstile) ────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# بيانات تجريبية تُنشأ تلقائياً مرة واحدة عند أول تشغيل على قاعدة فارغة (false لتعطيلها)
SEED_DEMO_DATA=true

# ── متقدم ───────────────────────────────────────────────────
# اجعلها true فقط للتجربة على HTTP غير آمن (لا تستخدمها في الإنتاج)
INSECURE_COOKIES=false
